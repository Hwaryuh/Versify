{
  "manifest_version": 3,
  "name": "Versify",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "author": "Hwaryuh",
  "default_locale": "ko",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://lrclib.net/*",
    "https://api.lyrics.ovh/*",
    "https://musicbrainz.org/*",
    "https://*.deepl.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/player-observer.js",
        "ui/panel.js",
        "ui/native-lyrics.js"
      ],
      "css": [
        "ui/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Versify"
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": false
  }
}
